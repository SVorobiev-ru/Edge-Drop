{
  "name": "edge-drop",
  "version": "0.3.2",
  "macRevision": 2,
  "description": "Edge-Drop — a clipboard manager that lives on the left edge of your screen and expands on hover.",
  "author": "Edge-Drop",
  "license": "Apache-2.0",
  "private": true,
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "predev": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/strip-dev-csp.cjs",
    "build:github": "npm run build && electron-builder --win nsis -c.extraMetadata.buildTarget=github",
    "build:store": "npm run build && electron-builder --win appx -c.extraMetadata.buildTarget=store",
    "build:msix": "npm run build && electron-builder --win appx -c.extraMetadata.buildTarget=store",
    "build:win": "npm run build:github",
    "package": "npm run build:github",
    "prepreview": "install-electron",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "build:mac": "npm run build && MAC_VERSION=$(node scripts/mac-version.cjs) && electron-builder --mac dir --publish never -c.extraMetadata.version=$MAC_VERSION",
    "dist:mac": "npm run build && node scripts/check-mac-native.cjs arm64 x64 && MAC_VERSION=$(node scripts/mac-version.cjs) && electron-builder --mac dmg zip --arm64 --x64 --publish never -c.extraMetadata.version=$MAC_VERSION && node scripts/mac-dmg-compress.cjs",
    "dist:mac:arm64": "npm run build && node scripts/check-mac-native.cjs arm64 && MAC_VERSION=$(node scripts/mac-version.cjs) && electron-builder --mac dmg zip --arm64 --publish never -c.extraMetadata.version=$MAC_VERSION && node scripts/mac-dmg-compress.cjs",
    "dist:mac:x64": "npm run build && node scripts/check-mac-native.cjs x64 && MAC_VERSION=$(node scripts/mac-version.cjs) && electron-builder --mac dmg zip --x64 --publish never -c.extraMetadata.version=$MAC_VERSION && node scripts/mac-dmg-compress.cjs",
    "install:mac": "bash scripts/install-mac.sh"
  },
  "build": {
    "appId": "com.edgedrop.app",
    "productName": "Edge-Drop",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "afterPack": "./scripts/mac-adhoc-sign.cjs",
    "files": [
      "out/**/*",
      "!out/ts/**",
      "!out/renderer/**/*.gif",
      "resources/**/*",
      "!resources/startup/**/*.exe",
      "!resources/startup/**/*.cs",
      "!resources/appx/**",
      "package.json",
      "!**/node_modules/emoji-datasource-twitter/**",
      "!**/node_modules/lucide-react/**",
      "!**/node_modules/gsap/**",
      "!**/node_modules/framer-motion/**",
      "!**/node_modules/@fontsource/**",
      "!**/node_modules/@iconify-json/**",
      "!**/node_modules/@iconify/react/**",
      "!**/node_modules/@radix-ui/**",
      "!**/node_modules/svg-path-bbox/**",
      "!**/node_modules/react-dom/**",
      "!**/node_modules/koffi/doc/**"
    ],
    "asarUnpack": [
      "**/*.{node,dll}",
      "**/node_modules/koffi/**/*",
      "**/node_modules/@koromix/**/*",
      "**/node_modules/@resvg/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "Deepender25",
      "repo": "Edge-Drop"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "appx",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "extraResources": [
        {
          "from": "node_modules/emoji-datasource-twitter/img/twitter/64",
          "to": "emoji/64"
        },
        {
          "from": "resources/startup/EdgeDropStartup.exe",
          "to": "startup/EdgeDropStartup.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Edge-Drop",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Edge-Drop-Setup-${version}.${ext}"
    },
    "appx": {
      "identityName": "Deepender.EdgeDrop",
      "publisher": "CN=55FECDC4-7144-4A41-98FC-056C003F76FD",
      "publisherDisplayName": "Deepender",
      "applicationId": "EdgeDrop",
      "displayName": "Edge Drop",
      "capabilities": [
        "runFullTrust",
        "internetClient"
      ],
      "customExtensionsPath": "resources/appx/startup-extensions.xml"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.icns",
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "12.0",
      "artifactName": "Edge-Drop-${version}-mac-${arch}.${ext}",
      "identity": null,
      "hardenedRuntime": false,
      "notarize": false,
      "electronLanguages": [
        "ar",
        "bn",
        "cs",
        "da",
        "de",
        "el",
        "en",
        "es",
        "fa",
        "fi",
        "fr",
        "he",
        "hi",
        "hu",
        "id",
        "it",
        "ja",
        "ko",
        "nl",
        "nb",
        "pl",
        "pt_BR",
        "pt_PT",
        "ro",
        "ru",
        "sv",
        "th",
        "tr",
        "uk",
        "vi",
        "zh_CN",
        "zh_TW"
      ],
      "files": [
        "out/**/*",
        "!out/ts/**",
        "!out/renderer/**/*.gif",
        "resources/**/*",
        "!resources/startup/**/*.exe",
        "!resources/startup/**/*.cs",
        "!resources/appx/**",
        "package.json",
        "!**/node_modules/emoji-datasource-twitter/**",
        "!**/node_modules/lucide-react/**",
        "!**/node_modules/gsap/**",
        "!**/node_modules/framer-motion/**",
        "!**/node_modules/@fontsource/**",
        "!**/node_modules/@iconify-json/**",
        "!**/node_modules/@iconify/react/**",
        "!**/node_modules/@radix-ui/**",
        "!**/node_modules/svg-path-bbox/**",
        "!**/node_modules/react-dom/**",
        "!**/node_modules/koffi/doc/**",
        "!**/node_modules/koffi/vendor/**",
        "!**/node_modules/koffi/lib/**",
        "!**/node_modules/koffi/cnoke.cjs",
        "!**/node_modules/koffi/src/**/*.{hh,inc,def,S,asm,txt}",
        "!**/node_modules/@koromix/koffi-!(darwin-${arch})/**",
        "!**/node_modules/@resvg/resvg-js-!(darwin-${arch})/**",
        "!**/node_modules/electron-updater/**",
        "!**/node_modules/builder-util-runtime/**",
        "!**/node_modules/debug/**",
        "!**/node_modules/ms/**",
        "!**/node_modules/sax/**",
        "!**/node_modules/fs-extra/**",
        "!**/node_modules/graceful-fs/**",
        "!**/node_modules/jsonfile/**",
        "!**/node_modules/universalify/**",
        "!**/node_modules/js-yaml/**",
        "!**/node_modules/argparse/**",
        "!**/node_modules/lazy-val/**",
        "!**/node_modules/lodash.escaperegexp/**",
        "!**/node_modules/lodash.isequal/**",
        "!**/node_modules/semver/**",
        "!**/node_modules/tiny-typed-emitter/**"
      ],
      "publish": {
        "provider": "github",
        "owner": "SVorobiev-ru",
        "repo": "Edge-Drop"
      },
      "extendInfo": {
        "LSUIElement": true,
        "NSAppleEventsUsageDescription": "Edge-Drop uses System Events to paste the selected item into the active app.",
        "NSDesktopFolderUsageDescription": "Edge-Drop reads copied files and screenshots from your Desktop folder.",
        "NSDocumentsFolderUsageDescription": "Edge-Drop reads copied files and screenshots from your Documents folder.",
        "NSDownloadsFolderUsageDescription": "Edge-Drop reads copied files and screenshots from your Downloads folder.",
        "NSCameraUsageDescription": null,
        "NSMicrophoneUsageDescription": null,
        "NSBluetoothAlwaysUsageDescription": null,
        "NSBluetoothPeripheralUsageDescription": null,
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "com.edgedrop.app",
            "CFBundleURLSchemes": [
              "edgedrop"
            ]
          }
        ]
      }
    }
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.73",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^43.7.7",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.1.0",
    "emoji-datasource-twitter": "^16.0.0",
    "framer-motion": "^11.0.24",
    "lucide-react": "^1.26.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "svg-path-bbox": "^2.1.0",
    "typescript": "^5.4.3",
    "vite": "^5.2.6",
    "vitest": "^4.1.10",
    "zustand": "^4.5.2"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron-updater": "^6.8.9",
    "koffi": "^3.1.2"
  }
}
